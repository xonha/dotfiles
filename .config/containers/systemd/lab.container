[Unit]
Description=Lab — personal Arch Linux development environment
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/toolbox:latest
ContainerName=lab
HostName=lab

UserNS=keep-id:uid=1000,gid=1000
# Startup creates SSH host keys; remote sessions log in as henrique.
User=root

Volume=lab-home.volume:/home/henrique:Z
Volume=%h/lab/workspace:/workspace:Z
Volume=%h/.ssh/authorized_keys:/run/host_ssh_key:ro,Z

PublishPort=2224:22
WorkingDir=/workspace
Memory=14g
PidsLimit=4096
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
