          "show": [
            "cpu",
            "cputemp",
            "ram",
            "disk",
            "gpu",
            "gputemp",
            "vram"
          ],
          "homeTiles": [
            "cpu",
            "ram",
            "gpu",
            "net",
            "io",
            "disk"
          ]
        },
        {
          "id": "robzolkos.github",
          "includeContributions": false,
          "linkBehavior": "Browser tab",
          "repositoryScope": "Owned and organizations",
          "refreshIntervalSec": 1800
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "alanfortlink.speech-to-text"
        },
        {
          "id": "xonha.tray",
          "reverse": true,
          "pinned": [],
          "hidden": []
        }
      ],
      "right": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "dorneles.lock-keys",
          "style": "icons",
          "badgeStyle": "flat",
          "mode": "active-only",
          "showNum": false,
          "showScroll": false,
          "showNotifications": false
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omaconnect"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "gigasolo.omavoice",
          "pinnedSource": "bluez_input.00:02:5B:00:FF:0E"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "promaa.clock",
          "birthYear": 1998,
          "format": "ddd, MMM dd HH:mm",
          "formatAlt": "ddd, MMM dd HH:mm",
          "lifeExpectancy": 101,
          "showNextEvent": true,
          "weekStartDay": "monday"
        },
        {
          "id": "omarchy.menu"
        }
      ]
    },
    "position": "top",
    "transparent": false
