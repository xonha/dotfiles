{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "io.github.diegopluna.argus",
          "homeTiles": [
            "cpu",
            "ram",
            "gpu",
            "net",
            "io",
            "disk"
          ],
          "intervalSec": 3,
          "show": [
            "cpu",
            "cputemp",
            "ram",
            "disk",
            "load"
          ]
        }
      ],
      "center": [
        {
          "id": "io.github.hogar1977.top-bar-dock"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "gigasolo.omavoice",
          "pinnedSource": "alsa_input.pci-0000_06_00.6.analog-stereo",
          "preset": "meeting"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.clock",
          "birthYear": 1998,
          "lifeExpectancy": 101,
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        }
      ]
    }
  },
  "plugins": []
}
