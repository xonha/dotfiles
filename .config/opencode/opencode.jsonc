{
  "$schema": "https://opencode.ai/config.json",
  // Token NAO fica aqui: o repo e publico. Exporta NOTION_TOKEN no ambiente
  // (ver ~/.zshenv.local ou o secret manager) que o opencode interpola em runtime.
  "mcp": {
    "notion": {
      "type": "local",
      "command": ["npx", "-y", "@notionhq/notion-mcp-server"],
      "environment": {
        "NOTION_TOKEN": "{env:NOTION_TOKEN}"
      }
    }
  }
}
