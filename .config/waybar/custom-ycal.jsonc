{
  "custom/ycal": {
    // instalado pelo pacote AUR waybar-ycal; o popup e um daemon GTK4
    // (waybar-ycal.service, usuario) que o toggle.sh acorda via SIGUSR1
    // wrapper nosso: mesmo cache do bar.py do pacote, formato do clock antigo
    "exec": "~/.config/scripts/ycal-bar.py",
    "return-type": "json",
    "interval": 60,
    "on-click": "/usr/share/waybar-ycal/toggle.sh",
    // herdados do modulo clock que esse aqui substituiu
    "on-click-right": "pavucontrol --tab=3",
    "on-scroll-up": "pulsemixer --max-volume 100 --change-volume +5",
    "on-scroll-down": "pulsemixer --max-volume 100 --change-volume -5",
  },
}
