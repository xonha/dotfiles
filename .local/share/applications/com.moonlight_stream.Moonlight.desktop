[Desktop Entry]
Name=Moonlight
Comment=Stream games and other applications from another PC running Sunshine or GeForce Experience
# FORCE_VAAPI=1: sem isso o Moonlight desprioriza VAAPI no driver Gallium e fica
# ciclando entre os renderers Vulkan/SDL/VAAPI varias vezes por segundo, o que
# destroi e recria a janela do stream (flicker). Regressao a partir do
# mesa 26.2.1 na Vega 8 (Raven). Remover quando o Mesa corrigir.
Exec=env FORCE_VAAPI=1 moonlight
Icon=moonlight
Terminal=false
Type=Application
Categories=Qt;Game;
Keywords=nvidia;gamestream;stream;sunshine;remote play;
