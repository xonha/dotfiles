# Copy to ~/.config/containers/systemd/keeper.env and chmod 600.
# Keep these values out of Git.

BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Initial local URL. Add the LAN/Tailscale URL here if you use one.
BETTER_AUTH_URL=https://bazzite.tail9319fe.ts.net:8444
TRUSTED_ORIGINS=https://bazzite.tail9319fe.ts.net:8444,http://localhost:8088

# Optional: required only for Google Calendar and Outlook.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Keeper's standalone image requires this to be enabled.
WORKER_JOB_QUEUE_ENABLED=true
