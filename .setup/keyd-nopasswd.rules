// Installed to /etc/polkit-1/rules.d/49-keyd-nopasswd.rules by .setup/keyd.sh
//
// Lets dock-handler.sh start/stop keyd without a password prompt.
// Scoped to keyd.service on purpose: manage-units carries a "unit" detail, so
// this grants nothing for any other service. Do NOT widen this to
// manage-unit-files (enable/disable) — that action has no unit detail and
// implies manage-units + reload-daemon for every unit on the system.
//
// __USER__ is replaced with the installing user at setup time.

polkit.addRule(function (action, subject) {
  if (
    action.id == "org.freedesktop.systemd1.manage-units" &&
    action.lookup("unit") == "keyd.service" &&
    subject.user == "__USER__"
  ) {
    return polkit.Result.YES;
  }
});
