# Proxy HTTPS dos serviços privados do bazzite em *.plu.nz.
# Os registros DNS apontam para o IP do bazzite no Tailscale (DNS only), e o
# Tailscale Serve encaminha a porta 443 da tailnet para 127.0.0.1:8453.
# Nada aqui é alcançável fora da tailnet.
{
	admin off
	default_bind 127.0.0.1
	http_port 8452
	https_port 8453
	auto_https disable_redirects
	# O Tailscale Serve só encaminha TCP; sem HTTP/3, o Caddy não anuncia
	# alt-svc para uma porta UDP 8453 que ninguém na tailnet alcança.
	servers {
		protocols h1 h2
	}
}

*.plu.nz {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}

	@keeper host keeper.plu.nz
	handle @keeper {
		reverse_proxy 127.0.0.1:8088
	}

	@songmirror host songmirror.plu.nz
	handle @songmirror {
		reverse_proxy 127.0.0.1:8888
	}

	# Crafty e Sunshine só servem HTTPS com certificado autoassinado.
	@crafty host crafty.plu.nz
	handle @crafty {
		reverse_proxy https://127.0.0.1:8443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@sunshine host sunshine.plu.nz
	handle @sunshine {
		reverse_proxy https://127.0.0.1:47990 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle {
		abort
	}
}
