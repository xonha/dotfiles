# Caddy com o módulo DNS da Cloudflare, para emitir o certificado *.plu.nz
# pelo desafio DNS-01 sem expor nenhuma porta à internet.
FROM docker.io/library/caddy:2-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM docker.io/library/caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
