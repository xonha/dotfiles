[Unit]
Description=Start Immich server
RequiresMountsFor=/run/media/system/hd
Wants=network-online.target
After=network-online.target podman-restart.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/immich
ExecStart=%h/.local/libexec/immich-healthcheck.sh
TimeoutStartSec=180
Restart=on-failure
RestartSec=60s
KillMode=process

[Install]
WantedBy=default.target
