[Unit]
Description=Jellyfin media server
StartLimitIntervalSec=0
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/jellyfin/jellyfin:latest
ContainerName=jellyfin
UserNS=keep-id
User=1000:1000
PublishPort=127.0.0.1:8096:8096
Volume=%h/.local/share/jellyfin/config:/config
Volume=%h/.local/share/jellyfin/cache:/cache
Volume=/run/media/system/hd/mediarium/movies:/media/movies:ro
Volume=/run/media/system/hd/mediarium/tv:/media/tv:ro
Volume=/run/media/system/hd/mediarium/music:/media/music:ro
SecurityLabelDisable=true
Environment=TZ=America/Sao_Paulo

[Service]
ExecStartPre=/usr/bin/bash -c 'test "$(findmnt -rn -M /run/media/system/hd -o SOURCE)" = /dev/sdb1'
Restart=on-failure
RestartSec=30
TimeoutStartSec=300

[Install]
WantedBy=default.target
