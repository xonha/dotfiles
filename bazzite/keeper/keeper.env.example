# Copy to ~/.config/containers/systemd/keeper.env and chmod 600.
# Keep these values out of Git.

BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Private URL served by Caddy over the tailnet (see bazzite/caddy/README.md).
# The Tailscale Serve URL stays trusted as a fallback.
BETTER_AUTH_URL=https://keeper.plu.nz
TRUSTED_ORIGINS=https://keeper.plu.nz,https://bazzite.tail9319fe.ts.net:8444,http://localhost:8088

# Optional: required only for Google Calendar and Outlook.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Keeper's standalone image requires this to be enabled.
WORKER_JOB_QUEUE_ENABLED=true
