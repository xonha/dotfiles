[Unit]
Description=SongMirror — self-hosted music playlist sync
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/ahnafnafee/songmirror:latest
ContainerName=songmirror
Volume=%h/.local/share/songmirror/data:/data:Z
PublishPort=127.0.0.1:8888:8080
Environment=SONGMIRROR_DATA_DIR=/data
Environment=SONGMIRROR_ENV_FILE=/data/app.env
Environment=SPOTIFY_TOKEN_CACHE=/data/spotify_token_cache
Environment=APPLE_CACHE_FILE=/data/apple_resolve_cache.json
Environment=SONG_CACHE_FILE=/data/song_cache.db
Environment=SPOTIFY_TRACKS_CACHE=/data/spotify_tracks_cache.json
Environment=DOWNLOAD_STATE_FILE=/data/download_state.json
Environment=YTMUSIC_AUTH_FILE=/data/ytmusic_oauth.json
Environment=YTMUSIC_CACHE_FILE=/data/ytmusic_resolve_cache.json
Environment=TIDAL_TOKEN_FILE=/data/tidal_oauth.json
Environment=TIDAL_CACHE_FILE=/data/tidal_resolve_cache.json
Environment=DEEZER_TOKEN_FILE=/data/deezer_oauth.json
Environment=DEEZER_WEB_SESSION_FILE=/data/deezer_web_session.json
Environment=DEEZER_CACHE_FILE=/data/deezer_resolve_cache.json
Environment=QOBUZ_CACHE_FILE=/data/qobuz_resolve_cache.json
Environment=AMAZON_MUSIC_TOKEN_FILE=/data/amazon_music_oauth.json
Environment=AMAZON_MUSIC_WEB_SESSION_FILE=/data/amazon_music_web_session.json
Environment=AMAZON_MUSIC_CACHE_FILE=/data/amazon_music_resolve_cache.json
Environment=YTMUSIC_BROWSER_AUTH=/data/ytmusic_browser.json
Environment=LASTFM_CACHE_FILE=/data/lastfm_resolve_cache.json
Environment=SPOTIFY_CACHE_FILE=/data/spotify_resolve_cache.json
Environment=SPOTIFY_OAUTH_OPEN_BROWSER=0

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
