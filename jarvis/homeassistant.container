[Unit]
Description=Home Assistant on Jarvis
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/home-assistant/home-assistant:2026.10.2
ContainerName=homeassistant
Network=host
Volume=%h/.local/share/jarvis/homeassistant:/config:Z
Environment=TZ=America/Sao_Paulo
StopTimeout=60

[Service]
Restart=on-failure
TimeoutStartSec=600
TimeoutStopSec=90

[Install]
WantedBy=default.target
