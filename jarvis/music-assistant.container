[Unit]
Description=Music Assistant on Jarvis
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/music-assistant/server:2.10.7
ContainerName=music-assistant
Network=host
Volume=%h/.local/share/jarvis/music-assistant:/data:Z
Environment=LOG_LEVEL=info

[Service]
Restart=on-failure
TimeoutStartSec=600

[Install]
WantedBy=default.target
