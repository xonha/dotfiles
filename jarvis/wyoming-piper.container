[Unit]
Description=Wyoming Piper speech synthesis on Jarvis
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/rhasspy/wyoming-piper:2.5.2
ContainerName=wyoming-piper
PublishPort=127.0.0.1:10200:10200
Volume=%h/.local/share/jarvis/wyoming-piper:/data:Z
Exec=--voice pt_BR-faber-medium

[Service]
Restart=on-failure
TimeoutStartSec=600

[Install]
WantedBy=default.target
