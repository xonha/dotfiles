[Unit]
Description=Wyoming Whisper speech recognition on Jarvis
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/rhasspy/wyoming-whisper:3.8.1
ContainerName=wyoming-whisper
PublishPort=127.0.0.1:10300:10300
Volume=%h/.local/share/jarvis/wyoming-whisper:/data:Z
Environment=WYO_WHISPER_MODEL=base-int8
Environment=WYO_WHISPER_LANGUAGE=pt-BR

[Service]
Restart=on-failure
TimeoutStartSec=600

[Install]
WantedBy=default.target
