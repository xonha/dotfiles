#!/bin/bash

# Keep the Tinta GTK themes (config/tinta*, from plu-nz/web.tinta) in sync
# after Omarchy's GNOME integration runs.
case "${1:-}" in
  tinta-dark)
    gsettings set org.gnome.desktop.interface gtk-theme "Tinta-Dark"
    gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
    ;;
  tinta-light)
    gsettings set org.gnome.desktop.interface gtk-theme "Tinta-Light"
    gsettings set org.gnome.desktop.interface color-scheme "prefer-light"
    ;;
esac
