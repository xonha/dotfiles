# Environment secrets (tokens, API keys). Sourced by config/bash.conf with
# auto-export, so plain KEY=value lines become environment variables.
#
# Only this commented template is versioned. Local edits are hidden from git
# with `git update-index --skip-worktree secrets.env` (setup/dotfiles.sh runs
# it), so tokens added below are never staged. Keep it private: chmod 600.
#
# GITHUB_TOKEN=
# ANTHROPIC_API_KEY=
